{
  "expo": {
    "name": "MeatInMinutes",
    "slug": "pro-licious-app",
    "version": "1.0.4",
    "orientation": "portrait",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "icon": "./assets/appicon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meatinminutes.app"
    },
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/appicon.png",
        "backgroundColor": "#09090b"
      },
      "package": "com.meatinminutes.app"
    },
    "web": {
      "favicon": "./assets/appicon.png"
    },
    "extra": {
      "apiUrl": "https://pro-licious-be.vercel.app",
      "eas": {
        "projectId": "6631a678-93e0-4874-88a3-e2f8ece59856"
      }
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf",
            "node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/MaterialIcons.ttf",
            "node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/FontAwesome.ttf"
          ]
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090b",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ]
    ]
  }
}

